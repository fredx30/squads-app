# Copy to docker/release.env (gitignored) to sign local release builds like CI does.
# Same variable names as the GitHub Actions secrets (set by the Setup signing keys workflow).
# KEYSTORE_BASE64 is `base64 -w0 release.keystore` (PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes('release.keystore')) )
KEYSTORE_BASE64=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
